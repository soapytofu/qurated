# Copy to .env and fill in.
# Choose anthropic or openai. Only the selected provider needs a key.
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional separate routing model; defaults to OPENAI_MODEL.
OPENAI_ROUTER_MODEL=
# Expand conversational interests into search keywords; 0 disables the extra model call.
SEARCH_QUERY_EXPANSION=0
ANTHROPIC_API_KEY=
# Any long random string; signs login cookies.
SESSION_SECRET=
# OAuth client ID from Google Cloud Console (Web application). See README.
GOOGLE_CLIENT_ID=
# Comma-separated email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=college.harvard.edu
# Max questions per student per day (protects your API credit).
DAILY_QUESTION_LIMIT=40
# Per student per minute, and total AI spend per day (USD) across all students; answers pause past it.
PER_MINUTE_QUESTION_LIMIT=6
DAILY_BUDGET_USD=20
# Set to 1 when served over HTTPS so cookies are Secure.
HTTPS_ONLY=0
# Comma-separated emails that also see per-answer cost.
ADMIN_EMAILS=
